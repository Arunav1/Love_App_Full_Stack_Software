# Server-only secrets. Never commit this file or put these values in client code.

# AI chat (Groq) – https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Spotify – create an app at https://developer.spotify.com/dashboard and paste its Client ID here.
# Redirect URIs to register in the app:  http://127.0.0.1:4000/spotify/callback  (and http://127.0.0.1:5173/spotify/callback for dev)
SPOTIFY_CLIENT_ID=

# Optional secret word that locks the whole app
ACCESS_CODE=
ACCESS_HINT=What do I call you? ♥
